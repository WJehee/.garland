
_default:
    just --list

# Set the project name to this directory's name (run after flake init, and again after adding the secretspec add-on)
init:
    for f in secretspec.toml Cargo.toml; do if [ -f "$f" ]; then sed -i "s/changeme/{{file_name(justfile_directory())}}/g" "$f"; fi; done

# Build the project
build:
    cargo build

# Run the main program
run:
    cargo run

# Lint with clippy
lint:
    cargo clippy --all-targets

# Format all sources
fmt:
    cargo fmt

