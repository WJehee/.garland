{
    description = "Garland - Nix Configurations";

    # Inputs are pinned by tack in .tack/pins.toml (lock: .tack/pins.lock.json)
    # rather than declared here, so `nix flake update` does nothing; use
    # `just update`. The resolver in .tack/default.nix is generated by
    # `tack init` and returns every pin as an evaluated flake, the same shape
    # flake inputs have.
    outputs = { self, ... }: let
        # The resolver result carries a __functor (calling it re-resolves with
        # overrides). It is stripped so flake-parts, which maps over all
        # inputs to build inputs', only ever sees flakes.
        inputs = removeAttrs (import ./.tack) [ "__functor" ] // { inherit self; };
    in inputs.flake-parts.lib.mkFlake { inherit inputs; } {
        imports = [
            (inputs.import-tree ./modules)
        ];
    };
}
